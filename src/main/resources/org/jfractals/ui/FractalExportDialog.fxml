<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.jfractals.ui.FractalExportDialogController"
      spacing="16"
      prefWidth="400">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <!-- File Selection Section -->
    <VBox spacing="6">
        <Label text="Export Location" style="-fx-font-weight: bold;"/>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <TextField fx:id="exportPathTextField" text="Select a file to save to..." HBox.hgrow="ALWAYS"/>
            <Button text="Browse..." onAction="#onBrowseClicked" minWidth="80"/>
        </HBox>
    </VBox>

    <Separator/>

    <!-- Parameters Form -->
    <GridPane hgap="12" vgap="12">
        <columnConstraints>
            <ColumnConstraints minWidth="130"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>

        <!-- Width -->
        <Label text="Image width (px)" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <Spinner fx:id="widthSpinner" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <!-- Height -->
        <Label text="Image height (px)" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <Spinner fx:id="heightSpinner" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <!-- Aspect Ratio -->
        <Label text="Aspect Ratio" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <HBox spacing="8" alignment="CENTER_LEFT" GridPane.rowIndex="2" GridPane.columnIndex="1">
            <Spinner fx:id="aspectRatioWidthSpinner" HBox.hgrow="ALWAYS"/>
            <Label text="by"/>
            <Spinner fx:id="aspectRatioHeightSpinner" HBox.hgrow="ALWAYS"/>
        </HBox>
    </GridPane>

    <Separator/>

    <!-- Bottom Action Bar -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Export may take a while..." textFill="#666666"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Export" defaultButton="true" minWidth="90" onAction="#onExportClicked"/>
    </HBox>
</VBox>