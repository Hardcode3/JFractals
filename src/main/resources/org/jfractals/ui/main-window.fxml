<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.CheckMenuItem?>

<BorderPane
    fx:controller="org.jfractals.ui.MainWindowController"
    xmlns:fx="http://javafx.com/fxml"
    stylesheets="@main-window-menu-bar.css">

    <top>
        <MenuBar>
            <menus>
                <Menu text="_Fractal">
                    <items>
                        <MenuItem text="Settings..." onAction="#showSettings" />
                    </items>
                </Menu>
                <Menu text="_View">
                    <items>
                        <MenuItem text="Reset View" onAction="#resetView" />
                        <CheckMenuItem fx:id="showScaleMenuItem" text="Show Scale" selected="true" />
                        <CheckMenuItem fx:id="showInfoLabel" text="Show Infos" selected="true" />
                        <CheckMenuItem fx:id="showZoomMenuItem" text="Show Zoom" selected="true" />
                        <CheckMenuItem fx:id="showCenterCoordinatesMenuItem" text="Show Center Coordinates" selected="true" />
                        <CheckMenuItem fx:id="showAxesMenuItem" text="Show Axes" selected="true" />
                    </items>
                </Menu>
            </menus>
        </MenuBar>
    </top>
    <center>
        <fx:include fx:id="fractalView" source="fractal-view.fxml" />
    </center>
</BorderPane>
